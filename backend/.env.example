# ==========================================
# VOXA (by VENE TURCO) - Production Environment Variables
# ==========================================

# Port & Environment
PORT=4000
NODE_ENV=production

# ------------------------------------------
# FASE 2: SEGURIDAD Y CREDENCIAL MAESTRA
# ------------------------------------------
# Clave secreta administrativa para proteger los endpoints /api/*
# Genera una clave segura de mínimo 32 caracteres (ej: openssl rand -hex 24)
ADMIN_SECRET_KEY=voxa_sec_9f83a8b417e2c94318d10b7

# ------------------------------------------
# IA ENGINE (Google Gemini 2.5 Flash)
# ------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------
# BASE DE DATOS HÍBRIDA (Cloud Firestore opcional)
# ------------------------------------------
# JSON stringificado de la cuenta de servicio de Firebase.
# Si se deja vacío, el sistema opera automáticamente con la Base de Datos Local JSON (data/db.json).
FIREBASE_SERVICE_ACCOUNT=

# ------------------------------------------
# META WHATSAPP CLOUD API (Opcional si usas conector QR)
# ------------------------------------------
META_WA_VERIFY_TOKEN=voxa_webhook_token_secure_2026
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_BUSINESS_ACCOUNT_ID=

# ------------------------------------------
# URL PÚBLICA DEL SERVIDOR (Render)
# ------------------------------------------
# Usada para el Keep-Alive 24/7 y la entrega de audios y comprobantes
PUBLIC_BASE_URL=https://voxa-hk3e.onrender.com
