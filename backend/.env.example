# Port & Environment
PORT=4000
NODE_ENV=development

# Gemini API Key (Official Google GenAI SDK - gemini-2.5-flash)
GEMINI_API_KEY=

# Firebase Admin (Optional - leave empty for automatic Local JSON DB fallback)
# Either a JSON string or path to serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT=

# Meta WhatsApp Cloud API (Optional - required only for live Meta Webhook)
META_WA_VERIFY_TOKEN=spoki_webhook_token_secure_2025
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_BUSINESS_ACCOUNT_ID=

# Server Public URL (Used for serving generated TTS audio files)
PUBLIC_BASE_URL=http://localhost:4000
